{
  "dashboard": {
    "title": "ZenCore CMS - 应用监控",
    "tags": ["application", "nestjs"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "请求率 (RPS)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[1m]))",
            "legendFormat": "总请求"
          },
          {
            "expr": "sum(rate(http_requests_total{status_code=~\"2..\"}[1m]))",
            "legendFormat": "成功请求"
          },
          {
            "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1m]))",
            "legendFormat": "错误请求"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 2,
        "title": "响应时间分布",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_ms_bucket[5m])) by (le))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (le))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_ms_bucket[5m])) by (le))",
            "legendFormat": "P99"
          }
        ],
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 3,
        "title": "错误率",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) * 100",
            "legendFormat": "错误率 (%)"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "yaxes": [
          {
            "format": "percent",
            "label": "错误率"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [5],
                "type": "gt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "type": "query"
            }
          ]
        }
      },
      {
        "id": 4,
        "title": "系统资源使用",
        "type": "graph",
        "targets": [
          {
            "expr": "system_cpu_usage_percent",
            "legendFormat": "CPU (%)"
          },
          {
            "expr": "system_memory_usage_percent",
            "legendFormat": "内存 (%)"
          },
          {
            "expr": "system_disk_usage_percent",
            "legendFormat": "磁盘 (%)"
          }
        ],
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 5,
        "title": "业务指标",
        "type": "stat",
        "targets": [
          {
            "expr": "active_users_total",
            "legendFormat": "活跃用户"
          },
          {
            "expr": "active_tenants_total",
            "legendFormat": "活跃租户"
          },
          {
            "expr": "total_contents",
            "legendFormat": "总内容数"
          },
          {
            "expr": "total_orders",
            "legendFormat": "总订单数"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 4
        }
      },
      {
        "id": 6,
        "title": "热门API端点",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum(rate(http_requests_total[5m])) by (route, method))",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 7,
        "title": "慢请求端点",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (route, le)))",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": {
          "x": 12,
          "y": 20,
          "w": 12,
          "h": 8
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}
